{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(go build *)",
      "Bash(go env *)",
      "Bash(go list *)",
      "Bash(go mod *)",
      "Bash(go test *)",
      "Bash(go version)",
      "Bash(go vet *)",
      "Bash(gofmt *)",
      "Bash(git branch*)",
      "Bash(git check-ignore*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git ls-files*)",
      "Bash(git show*)",
      "Bash(git status*)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Glob",
      "Grep",
      "Read"
    ],
    "deny": ["Bash(git commit --no-verify*)", "Bash(git push --no-verify*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh harness/claude/post-edit.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
